<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2-init-single-entities" author="tamara">
        <insert tableName="video">
            <column name="id" value="1"/>
            <column name="unique_file_name" value="placeholder_video_init"/>
            <column name="video_version" value="0"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>

        <insert tableName="document">
            <column name="id" value="1"/>
            <column name="unique_file_name" value="placeholder_doc_init"/>
            <column name="document_version" value="0"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="3-add-autoincrement-to-tables" author="tamara">
        <addAutoIncrement tableName="project"
                          columnName="id"
                          columnDataType="bigint"/>

        <addAutoIncrement tableName="contact_messages"
                          columnName="id"
                          columnDataType="bigint"/>

        <addAutoIncrement tableName="content"
                          columnName="id"
                          columnDataType="bigint"/>

        <addAutoIncrement tableName="image"
                          columnName="id"
                          columnDataType="biging"/>
    </changeSet>
</databaseChangeLog>